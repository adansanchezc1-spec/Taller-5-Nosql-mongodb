# ====================================================================
# ARCHIVO DE CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# ====================================================================
# INSTRUCCIONES:
# 1. Copie este archivo y renómbrelo como '.env'
# 2. Reemplace los valores de ejemplo con sus credenciales de MongoDB local o MongoDB Atlas.
# 3. NUNCA suba el archivo '.env' a repositorios públicos ni lo adjunte en entregas.

# Cadena de conexión URI a MongoDB
# Opción A (Local): mongodb://localhost:27017/
# Opción B (MongoDB Atlas): mongodb+srv://<usuario>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/

# Nombre de la Base de Datos a utilizar
MONGO_DB_NAME=techcare_db

# Tiempo límite de espera en milisegundos para intentar conexión
MONGO_TIMEOUT_MS=3000

# Modo de contingencia académica (True activa mock en memoria si no hay servidor local/Atlas activo)
USE_MOCK_FALLBACK=true
